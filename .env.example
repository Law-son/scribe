MONGODB_URI=mongodb+srv://...
JWT_SECRET=<run: openssl rand -base64 32>

# Africa's Talking SMS — https://africastalking.com
AT_API_KEY=<from AT dashboard>
AT_USERNAME=sandbox          # change to your AT username for production
AT_SENDER_ID=UCMScribe       # must be registered with AT

# App URL (set to Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
