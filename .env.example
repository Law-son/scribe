MONGODB_URI=mongodb+srv://...
JWT_SECRET=<run: openssl rand -base64 32>

# Agoo SMS — https://api.agoosms.com
AGOO_API_KEY=<agoo_live_... or agoo_test_...>
AGOO_SENDER_ID=<approved sender ID from Agoo dashboard>

# App URL (set to Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
